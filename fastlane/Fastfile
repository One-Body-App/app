platform :ios do
  before_all do
      cocoapods(podfile: "./ios")
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do

      setup_ci if ENV['CI']

      if ENV['CI']
      api_key = app_store_connect_api_key(
          key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
          issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
          key_content: ENV["APP_STORE_CONNECT_KEY"],
          duration: 1200,
        )
      end
      match( type: 'appstore', readonly: is_ci)


      increment_build_number(xcodeproj: "./ios/onebody.xcodeproj")
      build_app(export_method: "app-store",  workspace: "./ios/onebody.xcworkspace",export_options: {
          testFlightInternalTestingOnly: true
      })
      upload_to_testflight(skip_waiting_for_build_processing: true)
    end
  end

  desc "Push a new beta build to Release TestFlight"
  lane :prod do
    setup_ci if ENV['CI']
    api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_KEY"],
        duration: 1200,
      )
    match( type: 'appstore', readonly: is_ci)

    increment_build_number(xcodeproj: "./ios/onebody.xcodeproj")
     build_app(export_method: "app-store",  workspace: "./ios/onebody.xcworkspace")
     upload_to_testflight(skip_waiting_for_build_processing: true)


end

platform :android do
  desc "Push a new beta build to the play store"
  lane :beta do
    setup_ci if ENV['CI']

    gradle(task: 'clean', project_dir: './android')
    increment_version_code('app_project_dir': './android/app')
    gradle(task: 'bundle', build_type: 'Release', project_dir: './android')

    if ENV['CI']
      supply(track: 'internal', json_key_data: ENV['KEY_ANDROID_JSON_DATA'])
    else
      supply(track: 'internal', json_key_file: "./one-body-app-75cd2-a0bf70b6874e.json")
    end

  end

  desc "Push a new beta build for release to the play store"
  lane :prod do
    setup_ci if ENV['CI']

  end
end
