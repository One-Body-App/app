+- (CGRect)normalizedCropRectForWidth:(NSInteger)width
+                              height:(NSInteger)height
+                               cropX:(double)cropX
+                               cropY:(double)cropY
+                           cropWidth:(double)cropWidth
+                          cropHeight:(double)cropHeight {
+    NSInteger normalizedWidth = MAX(2, (NSInteger)cropWidth);
+    NSInteger normalizedHeight = MAX(2, (NSInteger)cropHeight);
+    if (normalizedWidth % 2 != 0) {
+        normalizedWidth -= 1;
+    }
+    if (normalizedHeight % 2 != 0) {
+        normalizedHeight -= 1;
+    }
+    normalizedWidth = MIN(MAX(2, normalizedWidth), width);
+    normalizedHeight = MIN(MAX(2, normalizedHeight), height);
+
+    NSInteger normalizedX = MAX(0, (NSInteger)cropX);
+    NSInteger normalizedY = MAX(0, (NSInteger)cropY);
+    if (normalizedX % 2 != 0) {
+        normalizedX -= 1;
+    }
+    if (normalizedY % 2 != 0) {
+        normalizedY -= 1;
+    }
+    normalizedX = MIN(normalizedX, MAX(0, width - normalizedWidth));
+    normalizedY = MIN(normalizedY, MAX(0, height - normalizedHeight));
+
+    return CGRectMake(normalizedX, normalizedY, normalizedWidth, normalizedHeight);
+}
