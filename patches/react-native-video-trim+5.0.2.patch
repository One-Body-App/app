+  private fun resolveProcessingInputPath(url: String): Pair<String, Boolean> {
+    if (url.startsWith("content://")) {
+      val uri = Uri.parse(url)
+      val inputStream =
+        reactApplicationContext.contentResolver.openInputStream(uri)
+          ?: throw IOException("Unable to open content URI: $url")
+      val tempFile =
+        File(reactApplicationContext.cacheDir, "videotrim_input_${System.currentTimeMillis()}.mp4")
+      copyToFile(inputStream, tempFile)
+      return Pair(tempFile.absolutePath, true)
+    }
+
+    if (url.startsWith("file://")) {
+      return Pair(url.removePrefix("file://"), false)
+    }
+
+    return Pair(url, false)
+  }
+
+  private fun copyToFile(inputStream: InputStream, targetFile: File) {
+    inputStream.use { input ->
+      FileOutputStream(targetFile).use { output ->
+        input.copyTo(output)
+      }
+    }
+  }
+
+  private fun createProcessedBitmap(
+    bitmap: Bitmap,
+    cropRect: CropRect,
+    outputWidth: Int,
+    outputHeight: Int
+  ): Bitmap {
+    val safeX = cropRect.x.coerceIn(0, (bitmap.width - 1).coerceAtLeast(0))
+    val safeY = cropRect.y.coerceIn(0, (bitmap.height - 1).coerceAtLeast(0))
+    val safeWidth = cropRect.width.coerceIn(1, bitmap.width - safeX)
+    val safeHeight = cropRect.height.coerceIn(1, bitmap.height - safeY)
+    val croppedBitmap = Bitmap.createBitmap(bitmap, safeX, safeY, safeWidth, safeHeight)
+    return if (croppedBitmap.width == outputWidth && croppedBitmap.height == outputHeight) {
+      croppedBitmap
+    } else {
+      Bitmap.createScaledBitmap(croppedBitmap, outputWidth, outputHeight, true)
+    }
+  }
+
+  private fun resolveCropRect(
+    sourceWidth: Int,
+    sourceHeight: Int,
+    cropX: Double,
+    cropY: Double,
+    cropWidth: Double,
+    cropHeight: Double
+  ): CropRect {
+    val normalizedWidth = ensureEvenDimension(cropWidth.toInt(), sourceWidth)
+      .coerceAtMost(sourceWidth)
+      .coerceAtLeast(2)
+    val normalizedHeight = ensureEvenDimension(cropHeight.toInt(), sourceHeight)
+      .coerceAtMost(sourceHeight)
+      .coerceAtLeast(2)
+    val maxX = (sourceWidth - normalizedWidth).coerceAtLeast(0)
+    val maxY = (sourceHeight - normalizedHeight).coerceAtLeast(0)
+    val normalizedX = ensureEvenCoordinate(cropX.toInt()).coerceIn(0, maxX)
+    val normalizedY = ensureEvenCoordinate(cropY.toInt()).coerceIn(0, maxY)
+    return CropRect(normalizedX, normalizedY, normalizedWidth, normalizedHeight)
+  }
+
+  private fun ensureEvenDimension(value: Int, fallback: Int): Int {
+    val safeValue = (if (value > 0) value else fallback).coerceAtLeast(2)
+    return if (safeValue % 2 == 0) safeValue else safeValue - 1
+  }
+
+  private fun ensureEvenCoordinate(value: Int): Int {
+    val safeValue = value.coerceAtLeast(0)
+    return if (safeValue % 2 == 0) safeValue else safeValue - 1
+  }
+
+  data class CropRect(
+    val x: Int,
+    val y: Int,
+    val width: Int,
+    val height: Int
+  )
