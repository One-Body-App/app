+- (void)extractEditedFrames:(nonnull NSString *)url options:(JS::NativeVideoTrim::EditedFrameOptions &)options resolve:(nonnull RCTPromiseResolveBlock)resolve reject:(nonnull RCTPromiseRejectBlock)reject {
+    NSURL *inputURL = [self resolveInputURL:url];
+    if (!inputURL) {
+        reject(@"INVALID_URL", @"Invalid input URL", nil);
+        return;
+    }
+
+    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+        AVAsset *asset = [AVAsset assetWithURL:inputURL];
+        AVAssetTrack *videoTrack = [[asset tracksWithMediaType:AVMediaTypeVideo] firstObject];
+        if (!videoTrack) {
+            reject(@"EXTRACT_EDITED_FRAMES_FAILED", @"Video track unavailable", nil);
+            return;
+        }
+
+        CGSize presentationSize = CGSizeApplyAffineTransform(videoTrack.naturalSize, videoTrack.preferredTransform);
+        NSInteger sourceWidth = (NSInteger)fabs(presentationSize.width);
+        NSInteger sourceHeight = (NSInteger)fabs(presentationSize.height);
+        NSInteger outputWidth = MAX(2, (NSInteger)options.outputWidth());
+        NSInteger outputHeight = MAX(2, (NSInteger)options.outputHeight());
+        NSInteger frameCount = MIN(10, MAX(1, (NSInteger)options.frameCount()));
+        CGRect cropRect = [self normalizedCropRectForWidth:sourceWidth
+                                                    height:sourceHeight
+                                                     cropX:options.cropX()
+                                                     cropY:options.cropY()
+                                                 cropWidth:options.cropWidth()
+                                                cropHeight:options.cropHeight()];
+
+        AVAssetImageGenerator *generator = [[AVAssetImageGenerator alloc] initWithAsset:asset];
+        generator.appliesPreferredTrackTransform = YES;
+        NSMutableArray<NSString *> *framePaths = [NSMutableArray array];
+        Float64 durationSeconds = CMTimeGetSeconds(asset.duration);
+        if (!isfinite(durationSeconds) || durationSeconds <= 0) {
+            reject(@"EXTRACT_EDITED_FRAMES_FAILED", @"Video duration unavailable", nil);
+            return;
+        }
+
+        NSURL *documentsDirectory = [[[NSFileManager defaultManager] URLsForDirectory:NSDocumentDirectory
+                                                                            inDomains:NSUserDomainMask] firstObject];
+
+        for (NSInteger index = 0; index < frameCount; index++) {
+            Float64 frameSecond = frameCount == 1
+                ? durationSeconds / 2.0
+                : (durationSeconds * (Float64)index) / (Float64)(frameCount - 1);
+            CMTime requestedTime = CMTimeMakeWithSeconds(frameSecond, 600);
+            NSError *frameError = nil;
+            CMTime actualTime = kCMTimeZero;
+            CGImageRef imageRef = [generator copyCGImageAtTime:requestedTime actualTime:&actualTime error:&frameError];
+            if (!imageRef || frameError) {
+                if (imageRef) {
+                    CGImageRelease(imageRef);
+                }
+                continue;
+            }
+
+            @autoreleasepool {
+                UIImage *processedImage = [self processedImageFromCGImage:imageRef
+                                                                 cropRect:cropRect
+                                                              outputWidth:outputWidth
+                                                             outputHeight:outputHeight];
+                CGImageRelease(imageRef);
+                if (!processedImage) {
+                    continue;
+                }
+
+                NSData *imageData = UIImageJPEGRepresentation(processedImage, 0.88);
+                if (!imageData) {
+                    continue;
+                }
+
+                NSString *fileName = [NSString stringWithFormat:@"%@_%lld_%ld.jpg", self.FILE_PREFIX, (long long)[[NSDate date] timeIntervalSince1970], (long)index];
+                NSURL *frameURL = [documentsDirectory URLByAppendingPathComponent:fileName];
+                NSError *writeError = nil;
+                [imageData writeToURL:frameURL options:NSDataWritingAtomic error:&writeError];
+                if (!writeError) {
+                    [framePaths addObject:frameURL.absoluteString];
+                }
+            }
+        }
+
+        resolve(framePaths);
+    });
+}
