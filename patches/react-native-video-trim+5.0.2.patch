+- (UIImage *)processedImageFromCGImage:(CGImageRef)cgImage
+                              cropRect:(CGRect)cropRect
+                           outputWidth:(NSInteger)outputWidth
+                          outputHeight:(NSInteger)outputHeight {
+    CGRect integralCropRect = CGRectIntegral(cropRect);
+    CGImageRef croppedImage = CGImageCreateWithImageInRect(cgImage, integralCropRect);
+    if (!croppedImage) {
+        return nil;
+    }
+
+    UIGraphicsBeginImageContextWithOptions(CGSizeMake(outputWidth, outputHeight), YES, 1.0);
+    CGContextRef context = UIGraphicsGetCurrentContext();
+    if (!context) {
+        CGImageRelease(croppedImage);
+        UIGraphicsEndImageContext();
+        return nil;
+    }
+
+    CGContextSetInterpolationQuality(context, kCGInterpolationHigh);
+    UIImage *image = [UIImage imageWithCGImage:croppedImage];
+    [image drawInRect:CGRectMake(0, 0, outputWidth, outputHeight)];
+    UIImage *scaledImage = UIGraphicsGetImageFromCurrentImageContext();
+    UIGraphicsEndImageContext();
+    CGImageRelease(croppedImage);
+    return scaledImage;
+}
