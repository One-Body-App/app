+  override fun extractEditedFrames(url: String, options: ReadableMap, promise: Promise) {
+    Thread {
+      var releaseInputPath: String? = null
+      var retriever: MediaMetadataRetriever? = null
+      try {
+        val resolvedInput = resolveProcessingInputPath(url)
+        val inputPath = resolvedInput.first
+        if (resolvedInput.second) {
+          releaseInputPath = inputPath
+        }
+
+        retriever = MediaMetadataRetriever()
+        retriever.setDataSource(inputPath)
+
+        val sourceWidth =
+          retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH)?.toIntOrNull()
+            ?: 0
+        val sourceHeight =
+          retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT)?.toIntOrNull()
+            ?: 0
+        val durationMs =
+          retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)?.toLongOrNull()
+            ?: 0L
+
+        if (sourceWidth <= 0 || sourceHeight <= 0 || durationMs <= 0L) {
+          throw IllegalStateException("Unable to read video metadata for frame extraction.")
+        }
+
+        val cropRect = resolveCropRect(
+          sourceWidth,
+          sourceHeight,
+          options.getDouble("cropX"),
+          options.getDouble("cropY"),
+          options.getDouble("cropWidth"),
+          options.getDouble("cropHeight")
+        )
+        val outputWidth = ensureEvenDimension(options.getDouble("outputWidth").toInt(), 1080)
+        val outputHeight = ensureEvenDimension(options.getDouble("outputHeight").toInt(), 1080)
+        val frameCount = options.getDouble("frameCount").toInt().coerceIn(1, 10)
+
+        val framePaths = mutableListOf<String>()
+        for (index in 0 until frameCount) {
+          val timeUs =
+            if (frameCount == 1) {
+              (durationMs * 1000L) / 2L
+            } else {
+              ((durationMs * 1000L) * index.toLong()) / (frameCount - 1).toLong()
+            }
+
+          val bitmap =
+            retriever.getFrameAtTime(timeUs, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)
+              ?: continue
+          val processedBitmap =
+            createProcessedBitmap(bitmap, cropRect, outputWidth, outputHeight)
+          val framePath = StorageUtil.getOutputPath(reactApplicationContext, "jpg")
+          FileOutputStream(framePath).use { outputStream ->
+            processedBitmap.compress(Bitmap.CompressFormat.JPEG, 88, outputStream)
+          }
+
+          framePaths.add(framePath)
+          if (processedBitmap != bitmap) {
+            processedBitmap.recycle()
+          }
+          bitmap.recycle()
+        }
+
+        promise.resolve(Arguments.fromList(framePaths))
+      } catch (error: Exception) {
+        promise.reject("EXTRACT_EDITED_FRAMES_FAILED", error)
+      } finally {
+        try {
+          retriever?.release()
+        } catch (_: Exception) {
+        }
+        if (releaseInputPath != null) {
+          StorageUtil.deleteFile(releaseInputPath)
+        }
+      }
+    }.start()
+  }
