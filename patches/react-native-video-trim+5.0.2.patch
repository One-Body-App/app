+        ReturnCode *returnCode = [session getReturnCode];
+        if ([ReturnCode isSuccess:returnCode]) {
+            AVAsset *outputAsset = [AVAsset assetWithURL:outputURL];
+            AVAssetTrack *outputTrack = [[outputAsset tracksWithMediaType:AVMediaTypeVideo] firstObject];
+            CGSize outputPresentationSize = CGSizeApplyAffineTransform(outputTrack.naturalSize, outputTrack.preferredTransform);
+            NSDictionary *result = @{
+                @"outputPath": outputURL.absoluteString,
+                @"duration": @(CMTimeGetSeconds(outputAsset.duration) * 1000.0),
+                @"width": @((NSInteger)fabs(outputPresentationSize.width)),
+                @"height": @((NSInteger)fabs(outputPresentationSize.height))
+            };
+            resolve(result);
+        } else {
+            NSString *errorMessage = [NSString stringWithFormat:@"Command failed with state %@ and rc %@.%@",
+                                      [FFmpegKitConfig sessionStateToString:state],
+                                      returnCode,
+                                      [session getFailStackTrace] ?: @""];
+            reject(@"EXPORT_EDITED_VIDEO_FAILED", errorMessage, nil);
+        }
+    } withLogCallback:nil withStatisticsCallback:nil];
+}
