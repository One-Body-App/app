{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "**/*.tsx",
    "**/*.ts",
    "jest/**/*.js",
    "jest.setup.js",
    "scripts/**/*.js",
    "stubs/**/*.js"
  ],
  "exclude": ["node_modules", "ios/Pods", "ios/build", "android/build", "vendor"]
}
