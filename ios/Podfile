#  source 'https://github.com/CocoaPods/Specs.git'
#  source 'https://github.com/getsentry/sentry-cocoa.git' # ✅ this one

def node_require(script)
   # Resolve script with node to allow for hoisting
   require Pod::Executable.execute_command('node', ['-p',
     "require.resolve(
       '#{script}',
       {paths: [process.argv[1]]},
     )", __dir__]).strip
 end

 node_require('react-native/scripts/react_native_pods.rb')
 node_require('react-native-permissions/scripts/setup.rb')
 node_require('expo/scripts/autolinking.rb')

install! 'cocoapods', :deterministic_uuids => false
#use_frameworks! :linkage => :dynamic
use_modular_headers!
platform :ios, min_ios_version_supported
prepare_react_native_project!

production = ENV["PRODUCTION"] == "1"

linkage = ENV['USE_FRAMEWORKS'] || 'static'
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true
end


target 'onebody' do
  use_expo_modules!
  # Mapbox iOS downloads can use RNMAPBOX_MAPS_DOWNLOAD_TOKEN from your shell env.
  # Example: export RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.***

  setup_permissions([
    # 'AppTrackingTransparency',
    # 'Bluetooth',
    # 'Calendars',
    # 'CalendarsWriteOnly',
    'Camera',
    # 'Contacts',
    # 'FaceID',
    # 'LocationAccuracy',
    # 'LocationAlways',
    'LocationWhenInUse',
    # 'MediaLibrary',
    # 'Microphone',
    # 'Motion',
    'Notifications',
    # 'PhotoLibrary',
    # 'PhotoLibraryAddOnly',
    # 'Reminders',
    # 'Siri',
    # 'SpeechRecognition',
    # 'StoreKit',
  ])

  pod 'RNFS', :path => '../node_modules/react-native-fs'
  pod 'lottie-ios', :modular_headers => true
  pod 'lottie-react-native', :path => '../node_modules/lottie-react-native'
  pod 'fast_float', :podspec => '../node_modules/react-native/third-party-podspecs/fast_float.podspec'


  pod 'react-native-lottie-splash-screen', :path => '../node_modules/react-native-lottie-splash-screen'

  pod 'rn-fetch-blob',
      :path => '../node_modules/rn-fetch-blob'

  pod 'SDWebImageWebPCoder'
  pod 'libwebp', '1.3.2', :source => 'https://cdn.cocoapods.org/'
  pod 'TOCropViewController', '2.7.4'

  pod 'Firebase'
  pod 'FirebaseCoreInternal'
  pod 'GoogleUtilities'
  pod 'FirebaseCore'
  pod 'FirebaseAuth'
  pod 'FirebaseAuthInterop'
  pod 'FirebaseAppCheckInterop'
  pod 'FirebaseCoreExtension'
  pod 'RecaptchaInterop'
  pod 'RecaptchaEnterprise'

  # ✅ updated version
  #pod 'fmt', '~> 8.1.1'     ✅ resolves char8_t crash



  config = use_native_modules!


  use_react_native!(
    :path => config[:reactNativePath],

    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )


  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    $RNMapboxMaps.post_install(installer) if defined?($RNMapboxMaps) && $RNMapboxMaps

    envfiles = {
      'Debug' => '.env.local',
      'Release' => '.env.local',
    }

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if target.name == 'react-native-config'
          config.build_settings['ENVFILE'] = envfiles[config.name] || '.env.local'
        end

        config.build_settings['ENABLE_BITCODE'] = 'NO'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        current_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        minimum_target = min_ios_version_supported
        if current_target.to_f < minimum_target.to_f
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_target
        end
      end

      # Fix Xcode 15+ warnings about script phases not specifying outputs
      target.build_phases.each do |phase|
        if phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
          # Skip phases that already have outputs
          next if phase.output_paths && !phase.output_paths.empty?

          case phase.name
          when "Create Symlinks to Header Folders"
            # Add a dummy output file to satisfy Xcode's dependency analysis
            phase.output_paths = ["$(DERIVED_FILE_DIR)/$(PRODUCT_NAME)-symlinks.stamp"]
          when "[CP-User] [Hermes] Replace Hermes for the right configuration, if needed"
            # Add a dummy output file for Hermes script
            phase.output_paths = ["$(DERIVED_FILE_DIR)/hermes-config.stamp"]
          end
        end
      end
    end
  end


  static_frameworks = [
  'FirebaseAuthInterop',
  'FirebaseAppCheckInterop',
  'FirebaseCore',
  'FirebaseCoreExtension',
  'GoogleUtilities',
  'RecaptchaInterop',
  'RecaptchaEnterprise',
  'FirebaseCoreInternal',
  'FirebaseInstallations',
  'GoogleDataTransport',
  'nanopb',
  'FirebaseABTesting',
  'FirebaseAuth'
]

  pre_install do |installer|
    $RNMapboxMaps.pre_install(installer) if defined?($RNMapboxMaps) && $RNMapboxMaps
    installer.pod_targets.each do |pod|
      if static_frameworks.include?(pod.name)
        puts "Configuring #{pod.name} as static framework"
        def pod.build_type
          Pod::BuildType.new(:linkage => :static, :packaging => :framework)
        end
      end

      if pod.name.eql?('RNPermissions') || pod.name.start_with?('Permission-')
        def pod.build_type;
          Pod::BuildType.static_library # I assume you use CocoaPods >= 1.9
        end
      end
    end
  end

end
