{
  "hosting": {
    "appAssociation": "NONE",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/links/**",
        "dynamicLinks": true
      },
      {
        "source": "/auth/**",
        "destination": "/index.html"
      },
      {
        "source": "/login/**",
        "destination": "/index.html"
      },
      {
        "source": "/signup/**",
        "destination": "/index.html"
      },
      {
        "source": "/influencer/**",
        "destination": "/index.html"
      },
      {
        "source": "/**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/signup",
        "destination": "https://www.onebodyapp.com/",
        "type": 302
      },
      {
        "source": "/login",
        "destination": "https://www.onebodyapp.com/",
        "type": 302
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 3001,
      "host": "0.0.0.0"
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  },
  "functions": {
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  }
}
